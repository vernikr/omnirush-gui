+      const digestBuf = await crypto.subtle.digest("SHA-256", encoded);
+      const expectedHex = Array.from(new Uint8Array(digestBuf), (b) =>
+        b.toString(16).padStart(2, "0"),
+      ).join("");
+      expect(sha256Hex(sample)).toBe(expectedHex);
+    }
+  });
