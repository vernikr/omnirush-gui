+
+function anchorOverheadBytes(callRefId: string, isRead: boolean): number {
+  const anchorTag = `<a id="export-ref-${callRefId}"></a>\n\n`;
+  const captionExtra = isRead ? " · `sha256:000000000000`" : "_Output (`sha256:000000000000`):_\n\n";
