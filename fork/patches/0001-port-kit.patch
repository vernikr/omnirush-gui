++  const unquoted =
++    (rawArg.startsWith('"') && rawArg.endsWith('"') && rawArg.length >= 2) ||
++    (rawArg.startsWith("'") && rawArg.endsWith("'") && rawArg.length >= 2)
++      ? rawArg.slice(1, -1).trim()
