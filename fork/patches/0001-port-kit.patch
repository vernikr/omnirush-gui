++  const cleanLeaf = path.basename(String(fileName || "").trim()) || "omnirush-chat.md";
++  const ext = path.extname(cleanLeaf);
++  const stem = ext ? cleanLeaf.slice(0, -ext.length) : cleanLeaf;
++  const resolvedDir = path.resolve(directory);
