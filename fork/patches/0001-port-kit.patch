++  const match = /^\/export(?:\s+([\s\S]+))?$/i.exec(trimmed);
++  if (!match) return null;
++  const rawArg = (match[1] ?? "").trim();
++  if (!rawArg) return { filename: null };
++  if (rawArg.includes("\n") || rawArg.includes("\r")) return null;
