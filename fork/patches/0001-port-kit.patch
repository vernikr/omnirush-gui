+diff --git a/apps/desktop/electron/window-zoom.mjs b/apps/desktop/electron/window-zoom.mjs
+new file mode 100644
+index 0000000..606a062
+--- /dev/null
++++ b/apps/desktop/electron/window-zoom.mjs
+@@ -0,0 +1,124 @@
++/**
++ * Keeps each BrowserWindow's desired UI zoom factor synchronized without
++ * calling webContents.setZoomFactor while the window is still hidden before
++ * ready-to-show (electron#51972) or losing zoom across file:// #hash route
++ * transitions on Electron <43.3 (electron#54381).
++ *
++ * @typedef {{
++ *   isDestroyed?: () => boolean;
++ *   getZoomFactor?: () => number;
++ *   setZoomFactor?: (factor: number) => void;
++ *   on?: (event: string, listener: () => void) => unknown;
++ * }} ZoomableWebContents
++ *
++ * @typedef {{
++ *   isDestroyed?: () => boolean;
++ *   isVisible?: () => boolean;
++ *   on?: (event: string, listener: () => void) => unknown;
++ *   webContents?: ZoomableWebContents | null;
++ * }} ZoomableWindow
++ */
++
++/**
++ * @param {ZoomableWindow | null | undefined} win
++ * @returns {win is ZoomableWindow}
++ */
++function isUsableWindow(win) {
++  return Boolean(win && (typeof win.isDestroyed !== "function" || !win.isDestroyed()));
++}
++
++/**
++ * @param {ZoomableWindow | null | undefined} win
++ */
++function isWindowVisible(win) {
++  if (!isUsableWindow(win)) return false;
++  return typeof win.isVisible === "function" ? Boolean(win.isVisible()) : true;
++}
++
++export function createWindowZoomController() {
++  /** @type {WeakMap<ZoomableWindow, number>} */
++  const desiredFactors = new WeakMap();
++  /** @type {WeakSet<ZoomableWindow>} */
++  const attachedWindows = new WeakSet();
++  /** @type {WeakSet<ZoomableWindow>} */
++  const pendingWindows = new WeakSet();
++
++  /**
++   * @param {ZoomableWindow | null | undefined} win
++   */
++  function syncVisibleWindowZoom(win) {
++    if (!isUsableWindow(win) || !isWindowVisible(win)) return false;
++    const factor = desiredFactors.get(win);
++    if (typeof factor !== "number" || !Number.isFinite(factor) || factor <= 0) {
++      return false;
++    }
++    const contents = win.webContents;
++    if (!contents || (typeof contents.isDestroyed === "function" && contents.isDestroyed())) {
++      return false;
++    }
++    const pending = pendingWindows.delete(win);
++    if (!pending && typeof contents.getZoomFactor === "function") {
++      const current = contents.getZoomFactor();
++      if (Number.isFinite(current) && Math.abs(current - factor) <= 1e-3) {
++        return true;
++      }
++    }
++    contents.setZoomFactor?.(factor);
++    return true;
++  }
++
++  /**
++   * @param {ZoomableWindow | null | undefined} win
++   */
++  function attach(win) {
++    if (!isUsableWindow(win) || attachedWindows.has(win)) return;
++    attachedWindows.add(win);
++    const resync = () => {
++      syncVisibleWindowZoom(win);
++    };
++    if (typeof win.on === "function") {
++      win.on("show", resync);
++      win.on("restore", resync);
++    }
++    const contents = win.webContents;
++    if (contents && typeof contents.on === "function") {
++      contents.on("did-finish-load", resync);
++      contents.on("did-navigate-in-page", resync);
++    }
++  }
++
++  /**
++   * @param {ZoomableWindow | null | undefined} win
++   * @param {number} rawFactor
++   */
++  function setFactor(win, rawFactor) {
++    const factor = Number(rawFactor);
++    if (!isUsableWindow(win) || !Number.isFinite(factor) || factor <= 0) {
++      return false;
++    }
++    attach(win);
++    desiredFactors.set(win, factor);
++    if (!isWindowVisible(win)) {
++      pendingWindows.add(win);
++      return true;
++    }
++    pendingWindows.delete(win);
++    win.webContents?.setZoomFactor?.(factor);
++    return true;
++  }
++
++  /**
++   * @param {ZoomableWindow | null | undefined} win
++   */
++  function getDesiredFactor(win) {
++    if (!isUsableWindow(win)) return null;
++    return desiredFactors.get(win) ?? null;
++  }
++
++  return {
++    attach,
++    setFactor,
++    getDesiredFactor,
++    syncVisibleWindowZoom,
++  };
++}
+diff --git a/apps/desktop/electron/window-zoom.test.mjs b/apps/desktop/electron/window-zoom.test.mjs
+new file mode 100644
+index 0000000..0168e6a
+--- /dev/null
++++ b/apps/desktop/electron/window-zoom.test.mjs
+@@ -0,0 +1,143 @@
++import assert from "node:assert/strict";
++import { describe, it } from "node:test";
++import { createWindowZoomController } from "./window-zoom.mjs";
++
++/**
++ * @param {{ visible?: boolean; initialZoom?: number }} [options]
++ */
++function createFakeWindow(options = {}) {
++  let visible = options.visible ?? false;
++  let zoomFactor = options.initialZoom ?? 1;
++  let destroyed = false;
++  /** @type {Map<string, Array<() => void>>} */
++  const windowListeners = new Map();
++  /** @type {Map<string, Array<() => void>>} */
++  const contentsListeners = new Map();
++  /** @type {number[]} */
++  const setCalls = [];
++
++  /**
++   * @param {Map<string, Array<() => void>>} registry
++   * @param {string} event
++   * @param {() => void} listener
++   */
++  const addListener = (registry, event, listener) => {
++    const list = registry.get(event) ?? [];
++    list.push(listener);
++    registry.set(event, list);
++  };
++
++  /**
++   * @param {Map<string, Array<() => void>>} registry
++   * @param {string} event
++   */
++  const emit = (registry, event) => {
++    for (const listener of registry.get(event) ?? []) {
++      listener();
++    }
++  };
++
++  const win = {
++    isDestroyed: () => destroyed,
++    isVisible: () => visible,
++    /**
++     * @param {string} event
++     * @param {() => void} listener
++     */
++    on(event, listener) {
++      addListener(windowListeners, event, listener);
++      return win;
++    },
++    webContents: {
++      isDestroyed: () => destroyed,
++      getZoomFactor: () => zoomFactor,
++      /**
++       * @param {number} factor
++       */
++      setZoomFactor(factor) {
++        zoomFactor = factor;
++        setCalls.push(factor);
++      },
++      /**
++       * @param {string} event
++       * @param {() => void} listener
++       */
++      on(event, listener) {
++        addListener(contentsListeners, event, listener);
++        return win.webContents;
++      },
++    },
++    show() {
++      visible = true;
++      emit(windowListeners, "show");
++    },
++    emitInPageNavigation(resetZoomTo = zoomFactor) {
++      zoomFactor = resetZoomTo;
++      emit(contentsListeners, "did-navigate-in-page");
++    },
++    destroy() {
++      destroyed = true;
++    },
++    get setCalls() {
++      return setCalls;
++    },
++  };
++
++  return win;
++}
++
++describe("window zoom controller", () => {
++  it("defers webContents.setZoomFactor while the window is hidden until show", () => {
++    const controller = createWindowZoomController();
++    const win = createFakeWindow({ visible: false, initialZoom: 1 });
++
++    assert.equal(controller.setFactor(win, 1.3), true);
++    assert.equal(controller.getDesiredFactor(win), 1.3);
++    assert.deepEqual(win.setCalls, []);
++
++    win.show();
++    assert.deepEqual(win.setCalls, [1.3]);
++    assert.equal(win.webContents.getZoomFactor(), 1.3);
++  });
++
++  it("forces pending zoom sync on show even if HostZoomMap reported the same cached factor", () => {
++    const controller = createWindowZoomController();
++    const win = createFakeWindow({ visible: false, initialZoom: 1.3 });
++
++    assert.equal(controller.setFactor(win, 1.3), true);
++    assert.deepEqual(win.setCalls, []);
++
++    win.show();
++    assert.deepEqual(win.setCalls, [1.3]);
++  });
++
++  it("restores zoom when a file:// in-page hash navigation resets WebContents zoom to 1", () => {
++    const controller = createWindowZoomController();
++    const win = createFakeWindow({ visible: true, initialZoom: 1 });
++
++    assert.equal(controller.setFactor(win, 1.4), true);
++    assert.deepEqual(win.setCalls, [1.4]);
++
++    // Unchanged zoom on hash navigation avoids redundant setZoomFactor calls.
++    win.emitInPageNavigation(1.4);
++    assert.deepEqual(win.setCalls, [1.4]);
++
++    // A fragment-keyed HostZoomMap reset to 1.0 is immediately corrected.
++    win.emitInPageNavigation(1.0);
++    assert.deepEqual(win.setCalls, [1.4, 1.4]);
++    assert.equal(win.webContents.getZoomFactor(), 1.4);
++  });
++
++  it("rejects invalid zoom values and destroyed windows", () => {
++    const controller = createWindowZoomController();
++    const win = createFakeWindow({ visible: true });
++
++    assert.equal(controller.setFactor(win, 0), false);
++    assert.equal(controller.setFactor(win, -1), false);
++    assert.equal(controller.setFactor(win, Number.NaN), false);
++    assert.equal(controller.setFactor(null, 1.2), false);
++
++    win.destroy();
++    assert.equal(controller.setFactor(win, 1.2), false);
++  });
++});
