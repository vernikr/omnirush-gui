+++ b/fork/scripts/refresh-patches.mjs
@@ -0,0 +1,85 @@
+#!/usr/bin/env node
+/**
+ * Rewrites fork/patches from the working tree.
+ *
+ * Run this after fixing a patch that stopped applying: check out the branch the
+ * sync produces, make the port correct again, then regenerate the patches and
+ * commit them. The upstream commit the patches are generated against is written
+ * to fork/UPSTREAM_BASE, which sync-upstream.mjs fetches so `git apply --3way`
+ * has the blobs it needs.
+ *
+ * Usage:
+ *   node fork/scripts/refresh-patches.mjs [--base <upstream-sha>] [--root <dir>]
+ */
+import { mkdirSync, writeFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { execFileSync } from "node:child_process";
+import { PATCH_GROUPS } from "./lib/patch-groups.mjs";
+import { upstreamBase, upstreamCommitOf } from "./lib/git.mjs";
+
+export function refreshPatches({ root = process.cwd(), base, log = console.log } = {}) {
+  const target = base || upstreamCommitOf("HEAD", root) || upstreamBase(root);
+  if (!target) {
+    throw new Error("No base commit: pass --base <upstream-sha> or commit with an Upstream-Commit trailer.");
+  }
+  // The base goes on disk before the diffs are taken: fork/UPSTREAM_BASE is
+  // itself part of the port, and writing it afterwards would leave the patches
+  // one generation behind the tree they were generated from.
+  writeFileSync(resolve(root, "fork/UPSTREAM_BASE"), `${target}\n`, "utf8");
+
+  const portKitGroup = PATCH_GROUPS.find((group) => group.file === "0001-port-kit.patch");
+  const featureGroups = PATCH_GROUPS.filter((group) => group.file !== "0001-port-kit.patch");
+  const coveredFiles = new Set();
+  const written = [];
+
+  const writeGroupPatch = (group, extraExcludes = []) => {
+    const pathArgs = [...group.paths, ...extraExcludes];
+    const diff = execFileSync(
+      "git",
+      ["diff", "--no-renames", "--binary", target, "--", ...pathArgs],
+      { cwd: root, encoding: "utf8", maxBuffer: 64 * 1024 * 1024 },
+    );
+    if (!diff.trim()) {
+      log(`skipped ${group.file}: no changes against ${target.slice(0, 10)}`);
+      return;
+    }
+    if (group !== portKitGroup) {
+      const names = execFileSync(
+        "git",
+        ["diff", "--no-renames", "--name-only", target, "--", ...pathArgs],
+        { cwd: root, encoding: "utf8" },
+      )
+        .split("\n")
+        .map((line) => line.trim())
+        .filter(Boolean);
+      for (const name of names) coveredFiles.add(name);
+    }
+    const path = resolve(root, "fork/patches", group.file);
+    mkdirSync(dirname(path), { recursive: true });
+    writeFileSync(path, diff, "utf8");
+    written.push(group.file);
+    log(`wrote fork/patches/${group.file} (${group.title})`);
+  };
+
+  for (const group of featureGroups) {
+    const excludes = [...coveredFiles].map((file) => `:(exclude)${file}`);
+    writeGroupPatch(group, excludes);
+  }
+  // Write 0001-port-kit.patch last so its embedded fork/patches/* snapshot
+  // already reflects the regenerated sibling patches in a single pass.
+  if (portKitGroup) {
+    writeGroupPatch(portKitGroup);
+  }
+
+  log(`base recorded in fork/UPSTREAM_BASE: ${target}`);
+  return { base: target, written };
+}
+
+function main() {
+  const args = process.argv.slice(2);
+  const base = args.includes("--base") ? args[args.indexOf("--base") + 1] : undefined;
+  const root = args.includes("--root") ? resolve(args[args.indexOf("--root") + 1]) : process.cwd();
+  refreshPatches({ root, base });
+}
+
+if (process.argv[1] && process.argv[1].endsWith("refresh-patches.mjs")) main();
diff --git a/fork/scripts/sync-upstream.mjs b/fork/scripts/sync-upstream.mjs
new file mode 100644
index 00000000..a8808d08
--- /dev/null
+++ b/fork/scripts/sync-upstream.mjs
@@ -0,0 +1,199 @@
+#!/usr/bin/env node
+/**
+ * Rebuilds a branch as `upstream main + the patches in fork/patches`.
+ *
+ * The port is never rebased by hand: every sync checks out the upstream commit,
+ * applies the patches with `git apply --index --3way` (so a patch whose context
+ * moved still merges when it can) and commits the result once. If a patch
+ * cannot be applied the command fails with the patch name and the conflict, and
+ * the branch is left unpushed — see fork/README.md, "When a patch stops
+ * applying".
+ *
+ * Usage:
+ *   node fork/scripts/sync-upstream.mjs --upstream <owner/repo> [--ref main]
+ *     [--branch main] [--repo <owner/repo>] [--dry-run]
+ *
+ * Writes `changed`, `upstream`, `base`, `head` and `dry_run` to $GITHUB_OUTPUT
+ * when it runs in Actions.
+ */
+import { appendFileSync, cpSync, existsSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { PATCH_GROUPS } from "./lib/patch-groups.mjs";
+import { patchNames, run, upstreamBase } from "./lib/git.mjs";
+
+export function upstreamFetchSpec(ref) {
+  const sourceRef = ref.startsWith("refs/")
+    ? ref
+    : /^v\d/.test(ref)
+      ? `refs/tags/${ref}`
+      : `refs/heads/${ref}`;
+  if (!sourceRef.startsWith("refs/heads/") && !sourceRef.startsWith("refs/tags/")) {
+    throw new Error(`Unsupported upstream ref: ${ref}`);
+  }
+  const trackingRef = sourceRef.startsWith("refs/heads/")
+    ? sourceRef.replace("refs/heads/", "refs/remotes/upstream/")
+    : sourceRef.replace("refs/tags/", "refs/remotes/upstream/tags/");
+  return { sourceRef, trackingRef };
+}
+
+export function parseArgs(argv) {
+  const options = { ref: "main", branch: "main", root: process.cwd() };
+  for (let index = 0; index < argv.length; index += 1) {
+    const arg = argv[index];
+    const value = () => {
+      index += 1;
+      return argv[index];
+    };
+    if (arg === "--upstream") options.upstream = value();
+    else if (arg === "--ref") options.ref = value();
+    else if (arg === "--branch") options.branch = value();
+    else if (arg === "--repo") options.repo = value();
+    else if (arg === "--root") options.root = resolve(value());
+    else if (arg === "--dry-run") options.dryRun = true;
+    else throw new Error(`Unknown argument: ${arg}`);
+  }
+  if (!options.upstream) throw new Error("--upstream <owner/repo> is required.");
+  return options;
+}
+
+function git(args, options) {
+  return run("git", args, { ...options });
+}
+
+function gitQuiet(args, options) {
+  try {
+    return { ok: true, output: git(args, options) };
+  } catch (error) {
+    return { ok: false, output: `${error?.stdout ?? ""}${error?.stderr ?? error?.message ?? ""}`.trim() };
+  }
+}
+
+export function syncUpstream(options, io = {}) {
+  const log = io.log ?? console.log;
+  const {
+    upstream,
+    ref,
+    branch,
+    root,
+    dryRun = false,
+  } = options;
+  const cwd = { cwd: root };
+
+  // 1. Where upstream is now.
+  const remotes = git(["remote"], cwd).split("\n").map((value) => value.trim());
+  if (!remotes.includes("upstream")) git(["remote", "add", "upstream", `https://github.com/${upstream}.git`], cwd);
+  const { sourceRef, trackingRef } = upstreamFetchSpec(ref);
+  // Fork releases reuse upstream version tags, so `git fetch --tags` collides
+  // with tags already created by this repository. Fetch only the requested
+  // branch or tag into a namespaced remote-tracking ref instead.
+  git(["fetch", "--no-tags", "upstream", `${sourceRef}:${trackingRef}`], cwd);
+  const upstreamSha = git(["rev-parse", `${trackingRef}^{commit}`], cwd);
+
+  // The 3-way fallback needs the blobs the patches were generated from.
+  const base = upstreamBase(root);
+  if (base) gitQuiet(["fetch", "upstream", "--depth=1", base], cwd);
+
+  const previousSha = gitQuiet(["rev-parse", branch], cwd).ok ? git(["rev-parse", branch], cwd) : "";
+  const previousTree = previousSha ? git(["rev-parse", `${branch}^{tree}`], cwd) : "";
+
+  // 2. Rebuild the branch from the upstream commit.
+  const names = patchNames(root);
+  if (dryRun) {
+    log(`[dry-run] would reset ${branch} to ${upstreamSha} and apply ${names.length} patches`);
+    return { upstreamSha, base, previousSha, headSha: "", changed: false, dryRun: true, applied: [] };
+  }
+
+  // The patches live in the tree we are about to replace, so keep a copy
+  // outside the repository and apply them from there.
+  const stagingDir = mkdtempSync(join(tmpdir(), "fork-patches-"));
+  try {
+    for (const name of names) cpSync(join(root, "fork", "patches", name), join(stagingDir, name));
+
+    // 2. Rebuild the branch from the upstream commit.
+    git(["checkout", "-B", branch, upstreamSha], cwd);
+
+    // 3. Apply the port.
+    const applied = [];
+    for (const name of names) {
+      const patchPath = `fork/patches/${name}`;
+      const group = PATCH_GROUPS.find((entry) => entry.file === name);
+      // Add-only kits have no upstream context to merge. Applying those
+      // directly also handles new files when the release base is a shallow
+      // checkout; modified upstream files still use the 3-way fallback.
+      const applyArgs = group?.addsOnly
+        ? ["apply", "--index", "--whitespace=nowarn", join(stagingDir, name)]
+        : ["apply", "--index", "--3way", "--whitespace=nowarn", join(stagingDir, name)];
+      const result = gitQuiet(applyArgs, cwd);
+      if (!result.ok) {
+        throw new Error(
+          `${patchPath} does not apply to ${upstream}/${ref} (${upstreamSha}).\n` +
+          `${group ? `It carries: ${group.title}.\n` : ""}` +
+          `Fix it on a scratch branch, then run node fork/scripts/refresh-patches.mjs.\n\n${result.output}`,
+        );
+      }
+      applied.push(name);
+      log(`applied ${patchPath}`);
+    }
+
+    // A patch cannot contain itself, so the kit patch carries the previous
+    // generation of these files. Put back the copies that were just applied:
+    // then the branch holds the current generation and the next sync is a
+    // no-op instead of walking the kit backwards one generation per run.
+    const patchesDir = join(root, "fork", "patches");
+    if (existsSync(patchesDir)) {
+      for (const name of names) cpSync(join(stagingDir, name), join(patchesDir, name));
+      git(["add", "--", "fork/patches"], cwd);
+    }
+
+    // 4. One commit that records what it is built on.
+    const staged = git(["diff", "--cached", "--name-only"], cwd);
+    if (!staged) {
+      log(`nothing to commit: ${upstreamSha} plus the port is what ${branch} already holds`);
+      return { upstreamSha, base, previousSha, headSha: previousSha, changed: false, dryRun: false, applied };
+    }
+    git(
+      ["commit", "-m", `Apply the Intel macOS port on ${upstream}/${ref}`, "-m", `Upstream-Commit: ${upstreamSha}`],
+      { ...cwd, env: { GIT_AUTHOR_NAME: "fork-port[bot]", GIT_AUTHOR_EMAIL: "fork-port[bot]@users.noreply.github.com", GIT_COMMITTER_NAME: "fork-port[bot]", GIT_COMMITTER_EMAIL: "fork-port[bot]@users.noreply.github.com" } },
+    );
+    const headSha = git(["rev-parse", "HEAD"], cwd);
+    const headTree = git(["rev-parse", "HEAD^{tree}"], cwd);
+    log(`committed ${headSha} (${staged.split("\n").length} files changed)`);
+    return {
+      upstreamSha,
+      base,
+      previousSha,
+      headSha,
+      changed: headTree !== previousTree,
+      dryRun: false,
+      applied,
+    };
+  } finally {
+    rmSync(stagingDir, { recursive: true, force: true });
+  }
+}
+
+function main() {
+  const options = parseArgs(process.argv.slice(2));
+  const result = syncUpstream(options);
+  const output = process.env.GITHUB_OUTPUT;
+  const lines = [
+    `upstream=${result.upstreamSha}`,
+    `base=${result.base}`,
+    `head=${result.headSha}`,
+    `changed=${result.changed}`,
+    `dry_run=${result.dryRun}`,
+  ];
+  if (output) appendFileSync(output, `${lines.join("\n")}\n`);
+  else console.log(lines.join("\n"));
+  if (result.applied?.length) console.log(`Applied ${result.applied.length} patches on ${result.upstreamSha}.`);
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === new URL(import.meta.url).pathname) {
+  try {
+    main();
+  } catch (error) {
+    console.error(error instanceof Error ? error.message : String(error));
+    process.exit(1);
+  }
+}
diff --git a/fork/scripts/verify-port.mjs b/fork/scripts/verify-port.mjs
new file mode 100644
index 00000000..f561a37c
--- /dev/null
+++ b/fork/scripts/verify-port.mjs
@@ -0,0 +1,179 @@
+#!/usr/bin/env node
+/**
+ * Asserts that the port is intact after a sync.
+ *
+ * A patch can apply cleanly and still be wrong: upstream may have renamed a
+ * file the port edits, or reintroduced a line the port replaces. These checks
+ * fail the sync before anything is published, which is cheaper than shipping a
+ * release whose Intel leg quietly disappeared.
+ *
+ * Usage:
+ *   node fork/scripts/verify-port.mjs [--repo <owner/repo>] [--run-tests]
+ */
+import { existsSync, readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { execFileSync } from "node:child_process";
+import { portRepo } from "./lib/git.mjs";
+import { UNTOUCHED_PATHS } from "./lib/patch-groups.mjs";
+
+const RELEASE_WORKFLOW = ".github/workflows/release-desktop.yml";
+const ELECTRON_DIR = "apps/desktop/electron";
+const ENGINE_RELEASE = "apps/desktop/scripts/engine-release.json";
+
+export function readFileSafe(path, io) {
+  try {
+    return io.read(path);
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Every check gets the repository contents through `io` so the tests can run
+ * against fixtures in memory.
+ */
+export function portChecks({ repo, read, exists }) {
+  const has = (path, needle) => (read(path) ?? "").includes(needle);
+  return [
+    {
+      id: "intel-only-release",
+      description: "the release workflow builds Intel macOS only",
+      problems() {
+        const workflow = read(RELEASE_WORKFLOW) ?? "";
+        const missing = [];
+        const matrix = workflow.match(/^\s+matrix:\s*\n\s+include:\s*\n([\s\S]*?)^\s+runs-on:/m)?.[1] ?? "";
+        const legs = [...matrix.matchAll(/^\s+- name: (.+)$/gm)].map((match) => match[1].trim());
+        if (!matrix) missing.push("release-desktop.yml has no release build matrix");
+        if (legs.length !== 1 || legs[0] !== "macOS Intel") missing.push(`release matrix must contain only macOS Intel (found: ${legs.join(", ") || "none"})`);
+        for (const [needle, label] of [
+          ["runner: macos-15-intel", "the Intel runner"],
+          ["builder_args: --mac --x64", "the --mac --x64 build"],
+          ["update_manifest: latest-mac.yml", "the standard macOS update manifest"],
+          ["feed_asset: latest-mac.yml", "the direct update-feed asset name"],
+        ]) {
+          if (!matrix.includes(needle)) missing.push(`release matrix is missing ${label}`);
+        }
+        if (workflow.includes("merge-mac-feed")) missing.push("the obsolete multi-architecture merge job is still present");
+        if (!workflow.includes("for manifest in latest-mac.yml; do")) missing.push("publish verification still requires manifests for unsupported platforms");
+        return missing;
+      },
+    },
+    {
+      id: "unsigned-build",
+      description: "the build works without an Apple Developer ID",
+      problems() {
+        const workflow = read(RELEASE_WORKFLOW) ?? "";
+        const missing = [];
+        if (!workflow.includes("Resolve macOS signing")) missing.push("release-desktop.yml lost the signing decision step");
+        if (workflow.includes("if: matrix.platform == 'macos'\n") && !workflow.includes("steps.signing.outputs.enabled")) {
+          missing.push("a macOS step is gated on platform only, so it would run without a certificate");
+        }
+        if (/secrets\.MAC_CSC_LINK\s*!=/.test(workflow.replace(/^\s*#.*$/gm, "")) && /if:.*secrets\./.test(workflow)) {
+          missing.push("an if: expression reads the secrets context, which Actions refuses to parse");
+        }
+        return missing;
+      },
+    },
+    {
+      id: "feed-coordinates",
+      description: `the app reads releases from ${repo || "this repository"}`,
+      problems() {
+        if (!repo) return ["no repository to check against (--repo or fork/REPO)"];
+        const missing = [];
+        for (const file of ["main.mjs", "updater.mjs", "recovery.mjs"]) {
+          const path = `${ELECTRON_DIR}/${file}`;
+          const contents = read(path);
+          if (contents === null) missing.push(`${path} is missing`);
+          else if (!contents.includes(`github.com/${repo}/`)) missing.push(`${path} still points at another repository`);
+        }
+        const builder = read("apps/desktop/electron-builder.base.yml") ?? "";
+        if (!builder.includes(`repo: ${repo.split("/")[1]}`)) missing.push("electron-builder.base.yml publishes to another repository");
+        for (const file of ["updater.mjs", "recovery.mjs"]) {
+          const contents = read(`${ELECTRON_DIR}/${file}`) ?? "";
+          if (contents.includes("https://github.com/omnirush-ai/omnirush-gui/releases/")) {
+            missing.push(`${file} still has a release-asset URL pointing at upstream`);
+          }
+        }
+        return missing;
+      },
+    },
+    {
+      id: "engine-pins",
+      description: "the pinned engine tarballs still come from upstream",
+      problems() {
+        const problems = [];
+        const contents = read(ENGINE_RELEASE) ?? "";
+        if (!contents.includes("omnirush-ai/omnirush-gui")) {
+          problems.push(`${ENGINE_RELEASE} no longer names the upstream repository: the pinned engine tarballs live there`);
+        }
+        for (const path of UNTOUCHED_PATHS) {
+          if (!exists(path)) problems.push(`${path} is missing`);
+        }
+        return problems;
+      },
+    },
+    {
+      id: "docs",
+      description: "the docs describe the Intel build",
+      problems() {
+        const readme = read("README.md") ?? "";
+        const updates = read("docs/updates.md") ?? "";
+        const missing = [];
+        if (!readme.includes("omnirush-mac-x64-")) missing.push("README.md has no Intel download row");
+        if (!updates.includes("mac-x64")) missing.push("docs/updates.md does not mention the Intel feed");
+        if (!exists("fork/README.md")) missing.push("fork/README.md is missing");
+        return missing;
+      },
+    },
+  ];
+}
+
+/** Runs `node --test` on the merge script, the way the release pipeline would. */
+export function runPortTests(root) {
+  try {
+    execFileSync(process.execPath, ["--test", "scripts/release/merge-mac-update-manifests.test.mjs"], {
+      cwd: root,
+      stdio: "pipe",
+      encoding: "utf8",
+    });
+    return [];
+  } catch (error) {
+    const output = `${error?.stdout ?? ""}${error?.stderr ?? ""}`.trim();
+    return [`scripts/release/merge-mac-update-manifests.test.mjs fails:\n${output.split("\n").slice(-12).join("\n")}`];
+  }
+}
+
+export function verifyPort({ root = process.cwd(), repo, runTests = false } = {}) {
+  const io = {
+    read: (path) => readFileSync(resolve(root, path), "utf8"),
+    exists: (path) => existsSync(resolve(root, path)),
+  };
+  const target = repo ?? portRepo(root);
+  const problems = [];
+  const results = [];
+  for (const check of portChecks({ repo: target, read: io.read, exists: io.exists })) {
+    const found = check.problems();
+    results.push({ id: check.id, description: check.description, ok: found.length === 0, problems: found });
+    problems.push(...found.map((problem) => `[${check.id}] ${problem}`));
+  }
+  if (runTests) problems.push(...runPortTests(root).map((problem) => `[tests] ${problem}`));
+  return { ok: problems.length === 0, problems, results };
+}
+
+function main() {
+  const args = process.argv.slice(2);
+  const repo = args.includes("--repo") ? args[args.indexOf("--repo") + 1] : undefined;
+  const runTests = args.includes("--run-tests");
+  const result = verifyPort({ repo, runTests });
+  for (const check of result.results) {
+    console.log(`${check.ok ? "ok  " : "FAIL"} ${check.id.padEnd(18)} ${check.description}`);
+    for (const problem of check.problems) console.log(`       ${problem}`);
+  }
+  if (!result.ok) {
+    console.error(`\nThe port is incomplete (${result.problems.length} problem(s)).`);
+    process.exit(1);
+  }
+  console.log("\nPort intact.");
+}
+
+if (process.argv[1] && process.argv[1].endsWith("verify-port.mjs")) main();
diff --git a/fork/tests/next-version.test.mjs b/fork/tests/next-version.test.mjs
new file mode 100644
index 00000000..0b2af3a4
--- /dev/null
+++ b/fork/tests/next-version.test.mjs
@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { FALLBACK_VERSION, nextVersion } from "../scripts/next-version.mjs";
+
+test("starts from the fallback when nothing has been published", () => {
+  assert.equal(nextVersion({}), FALLBACK_VERSION);
+  assert.equal(nextVersion({ published: [], upstream: null }), FALLBACK_VERSION);
+});
+
+test("bumps the fork's own latest release", () => {
+  assert.equal(nextVersion({ published: ["3.6.0"], upstream: "3.5.3" }), "3.6.1");
+  assert.equal(nextVersion({ published: ["3.6.0", "3.6.1"] }), "3.6.2");
+});
+
+test("never falls below an upstream release the fork has not caught up with", () => {
+  assert.equal(nextVersion({ published: ["3.6.5"], upstream: "3.7.0" }), "3.7.1");
+  assert.equal(nextVersion({ published: ["3.6.0"], upstream: "4.0.0" }), "4.0.1");
+});
+
+test("takes the first release above upstream when the fork is empty", () => {
+  assert.equal(nextVersion({ published: [], upstream: "3.5.3" }), "3.5.4");
+});
+
+test("ignores tags that are not stable versions", () => {
+  assert.equal(nextVersion({ published: ["v3.6.0-rc1", "3.6.0", "engine-1.18.32-r3"] }), "3.6.1");
+});
